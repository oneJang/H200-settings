OBJECT_STORAGE_PROVIDER="minio"

MINIO_NAMESPACE="object-storage"
MINIO_RELEASE_NAME="minio"
MINIO_STORAGE_CLASS="local-path"
MINIO_DATA_SIZE="20Gi"

# Image name only. Registry hostname/project is deliberately NOT hard-coded here.
MINIO_IMAGE_NAME="minio-community"

# Cluster-internal S3 endpoint
MINIO_S3_SERVICE="minio"
MINIO_S3_PORT="9000"

# Console exposure
MINIO_CONSOLE_SERVICE="minio-console"
MINIO_CONSOLE_PORT="9001"
MINIO_CONSOLE_SERVICE_TYPE="NodePort"   # ClusterIP | NodePort
MINIO_CONSOLE_NODEPORT="30901"          # used only for NodePort

# Root credential Secret. Credentials are entered interactively and never committed.
MINIO_ROOT_SECRET="minio-root-credentials"

# Basic resource requests; tune for the real H200 host/workload.
MINIO_CPU_REQUEST="250m"
MINIO_MEMORY_REQUEST="512Mi"

KFP_ARTIFACT_BUCKET="kubeflow-artifacts"
MLFLOW_ARTIFACT_BUCKET="mlflow-artifacts"
KFP_S3_SECRET="mlpipeline-minio-artifact"

# Dedicated MinIO identity used by KFP at runtime.
# The secret key is generated/stored in Kubernetes, never committed here.
KFP_S3_ACCESS_KEY="kfp-service"
KFP_S3_POLICY="kfp-artifacts"
