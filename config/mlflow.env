# ============================================================
# MLflow
# ============================================================

MLFLOW_NAMESPACE="mlflow"
MLFLOW_RELEASE_NAME="mlflow"

MLFLOW_IMAGE_NAME="mlflow-server"
KUBEFLOW_EXTERNAL_URL="http://192.168.253.134:8080"

# ============================================================
# Backend database
# ============================================================
# internal | external

MLFLOW_DATABASE_MODE="internal"

MLFLOW_MYSQL_DATABASE="mlflow"
MLFLOW_MYSQL_USER="mlflow"

# internal mode
MLFLOW_MYSQL_IMAGE_REPOSITORY="docker.io/library/mysql"

MLFLOW_MYSQL_PVC_SIZE="20Gi"

MLFLOW_MYSQL_CPU_REQUEST="500m"
MLFLOW_MYSQL_MEMORY_REQUEST="1Gi"

MLFLOW_MYSQL_CPU_LIMIT="2"
MLFLOW_MYSQL_MEMORY_LIMIT="2Gi"


# ============================================================
# External MySQL
# MLFLOW_DATABASE_MODE="external" 에서만 사용
# password는 저장하지 않는다.
# ============================================================

MLFLOW_EXTERNAL_MYSQL_HOST=""
MLFLOW_EXTERNAL_MYSQL_PORT="3306"
MLFLOW_EXTERNAL_MYSQL_DATABASE="mlflow"
MLFLOW_EXTERNAL_MYSQL_USER="mlflow"


# ============================================================
# MLflow server
# ============================================================

MLFLOW_WORKERS="1"

MLFLOW_CPU_REQUEST="500m"
MLFLOW_MEMORY_REQUEST="1Gi"

MLFLOW_CPU_LIMIT="2"
MLFLOW_MEMORY_LIMIT="2Gi"


# ============================================================
# Basic Auth
# ============================================================

MLFLOW_ADMIN_USERNAME="admin"

# Basic Auth SQLite DB가 이 PVC에 저장됨
MLFLOW_AUTH_PVC_SIZE="1Gi"


# ============================================================
# Storage
# ============================================================

MLFLOW_STORAGE_CLASS="local-path"


# ============================================================
# MinIO
# ============================================================

MLFLOW_S3_ACCESS_KEY="mlflow-service"
MLFLOW_S3_POLICY="mlflow-artifacts"


# ============================================================
# Kubeflow / Istio route
# ============================================================
# 처음에는 false 유지.
# MLflow 자체 검증 후 별도로 연동한다.

MLFLOW_KUBEFLOW_ROUTE_ENABLED="true"
