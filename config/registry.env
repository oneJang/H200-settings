# ============================================================
# Generic OCI image distribution
# ============================================================
# local    : build image on the Kubernetes node and import it into
#            containerd. Intended for a single-node/lab cluster.
# registry : push/pull through any OCI Distribution-compatible registry
#            (Harbor, GitLab Container Registry, NCR, Quay, etc.).
IMAGE_DISTRIBUTION_MODE="local"

# Used only when IMAGE_DISTRIBUTION_MODE="registry".
REGISTRY_SCHEME="https"                 # https | http
REGISTRY_HOST=""                        # e.g. registry.example.com
REGISTRY_PORT=""                        # blank = 443 for https, 80 for http
REGISTRY_REPOSITORY_PREFIX=""           # e.g. ml-platform or group/project
REGISTRY_TLS_VERIFY="true"              # true recommended; false only for controlled lab use
REGISTRY_AUTH_REQUIRED="true"
REGISTRY_USERNAME=""                    # optional; password/token is NEVER stored here
REGISTRY_PULL_SECRET_NAME="registry-credentials"

# ============================================================
# Optional Harbor deployment settings
# Used only by 30-registry/32-install-new-harbor.sh
# ============================================================
HARBOR_NAMESPACE="harbor"
HARBOR_ADMIN_SECRET="harbor-admin-password"
HARBOR_STORAGE_CLASS="local-path"
HARBOR_REGISTRY_SIZE="10Gi"

HARBOR_EXPOSE_TYPE="nodePort"           # nodePort | ingress | loadBalancer
HARBOR_TLS_ENABLED="false"
HARBOR_HTTP_NODEPORT="30080"
HARBOR_HTTPS_NODEPORT="30443"

# Uncomment only when HARBOR_EXPOSE_TYPE="ingress".
# HARBOR_DOMAIN="harbor.example.com"
# HARBOR_INGRESS_CLASS="nginx"
# HARBOR_TLS_SECRET="harbor-tls"
