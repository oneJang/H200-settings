GPU_OPERATOR_NAMESPACE="gpu-operator"

# 실제 H200에서는 true
# GPU 없는 테스트 VM에서는 설치하지 않고 render만 수행
GPU_OPERATOR_INSTALL="false"

# 초기에는 MIG 사용 안 함
GPU_MIG_STRATEGY="none"

# GPU Operator가 NVIDIA Driver를 관리
GPU_DRIVER_ENABLED="true"

# NVIDIA Container Toolkit도 Operator가 관리
GPU_TOOLKIT_ENABLED="true"

# DCGM Exporter 활성화
GPU_DCGM_EXPORTER_ENABLED="true"
